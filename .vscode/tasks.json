{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Debug Build (MSVC)",
            "type": "shell",
            /*
                For win32 platforrm layer.
                - user32.lib
                - Gdi32.lib

                For wgpu_native.lib as it is rust-lang bindings, and rust contains those libs in its standard lib.
                - ws2_32.lib 
                - ntdll.lib 
                - userenv.lib
            */
            "command": "mkdir build & cd src & cl /Zi /W3 /WX /Fo:..\\build/ /Fd:..\\build/ /Fe:..\\build/app.exe app_win32.c app.c base_layer\\base.c user32.lib Gdi32.lib ws2_32.lib ntdll.lib userenv.lib vendors\\webgpu\\wgpu_native.lib",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$msCompile"
            ]
        }
    ]
}